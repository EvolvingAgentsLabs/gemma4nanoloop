{"title": "Add a test for pending", "target_file": "tests/test_pending.py", "intent": "A pytest module with a test asserting Store().pending() is empty for a new store. Import Store from todo.store.", "defines": "test_pending_empty"}
{"title": "Add a test for complete", "target_file": "tests/test_complete.py", "intent": "A pytest module with a test asserting complete returns False for a title that was never added. Import Store from todo.store.", "defines": "test_complete_missing"}
{"title": "Add a test for all", "target_file": "tests/test_all.py", "intent": "A pytest module with a test asserting all() returns two items after adding two. Import Store from todo.store.", "defines": "test_all_returns_both"}
{"title": "Add a test for render_list", "target_file": "tests/test_list.py", "intent": "A pytest module with a test asserting render_list on an empty list returns an empty string. Import render_list from todo.format.", "defines": "test_render_list_empty"}
